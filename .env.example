# SPDX-License-Identifier: Apache-2.0
# Copy to .env and adjust. See README.md for details.

# Host port for LLMRouter (container port is always 8000).
# 9000 avoids colliding with MTPLX's default host port 8000.
LLMROUTER_HOST_PORT=9000

# Host port for Open WebUI (container port is always 8080).
OPENWEBUI_HOST_PORT=3000

# API key Open WebUI uses against LLMRouter.
# Must match the `key` under api_keys in llm-router/config.yaml.
LLMROUTER_API_KEY=sk-935bc9b7cc7dcf2c0a0737b2dd700c21ff072a1b0362f21b

# Set to "false" to disable user accounts (single-user mode).
WEBUI_AUTH=true
