# SPDX-License-Identifier: Apache-2.0
# Copy to .env and adjust. See README.md for details.

# --- host ports ---

# Host port for LiteLLM (container port is always 4000).
# 9001 avoids colliding with the MTPLX/oMLX default host port 8000.
LLMROUTER_HOST_PORT=9001

# Host port for Open WebUI (container port is always 8080).
OPENWEBUI_HOST_PORT=3000

# --- router ---

# API key that Open WebUI (and any other client) uses against LiteLLM.
# Replace the placeholder with a real key you generate (see README "Key hygiene").
ROUTER_API_KEY=sk-REPLACE_WITH_YOUR_KEY

# Set to "false" to disable user accounts (single-user mode).
WEBUI_AUTH=true

# --- backends (one or more) ---
# Declare each backend as BACKEND_<N>_* (N = 1..8, contiguous starting at 1).
#   BACKEND_<N>_TYPE             mtplx | lmstudio | omlx | mlx  (required)
#   BACKEND_<N>_HOST             default: host.docker.internal
#   BACKEND_<N>_PORT             default: 8000 (mtplx/omlx), 1234 (lmstudio), 8080 (mlx)
#   BACKEND_<N>_NAME             default: <type>-<port>
#   BACKEND_<N>_API_KEY          default: placeholder; set a real key if the
#                                server is started with authentication enabled
#
# Run each server on a distinct port. MTPLX and oMLX both default to 8000,
# so if you use both, give each a different BACKEND_<N>_PORT and pass --port
# to the respective server.
#
# mlx: mlx-vlm server running natively on the host (Apple Silicon, Metal/NPU).
#   Start with: python -m mlx_vlm --model mlx-community/gemma-4-12B-it-qat-4bit
#   See README.md for details. The model is loaded from the Hugging Face
#   cache at ~/.cache/huggingface/hub/models--mlx-community--gemma-4-12B-it-qat-4bit.

BACKEND_1_TYPE=mtplx       # mtplx serve --port 8000
BACKEND_2_TYPE=lmstudio    # LM Studio: Developer tab > Start Server (port 1234)
# BACKEND_3_TYPE=omlx      # omlx serve --model-dir ~/models --port 8001
# BACKEND_3_PORT=8001
# BACKEND_3_TYPE=mlx           # mlx-vlm serving mlx-community/gemma-4-12B-it-qat-4bit
# BACKEND_3_NAME=gemma4-12b-mlx
