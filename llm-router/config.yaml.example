# LiteLLM proxy configuration for MultiLLM.
# This is an example — copy to config.yaml and edit for your backends.
# See scripts/render-config.sh for automatic generation from .env BACKEND_* vars.

model_list:
  # MTPLX backend (host port 8000)
  - model_name: mtplx-qwen38-27b-optimized-speed
    litellm_params:
      model: openai/mtplx-qwen38-27b-optimized-speed
      api_base: http://host.docker.internal:8000/v1
      api_key: mtplx

  # LM Studio backend (host port 1234)
  - model_name: qwen3.6-35b-a3b-nvfp4
    litellm_params:
      model: openai/qwen3.6-35b-a3b-nvfp4
      api_base: http://host.docker.internal:1234/v1
      api_key: lmstudio

  # MLX backend (mlx-vlm server running as a container, service name mlx-vlm:8080)
  # The mlx-vlm service is started automatically by `docker compose up`.
  - model_name: mlx-8080
    litellm_params:
      model: openai/mlx-8080
      api_base: http://mlx-vlm:8080/v1
      api_key: placeholder
